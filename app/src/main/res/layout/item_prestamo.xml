<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_margin="10dp"
    app:layout_goneMarginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    android:background="@color/gris_claro"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:background="@color/grayclarito">

        <!-- Nombre del empleado y estado -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvEmpleado"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Empleado: Nombre del Empleado"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@android:color/white" />

            <TextView
                android:id="@+id/tvEstadoPrestamo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Estado: Activo"
                android:textSize="14sp"
                android:textColor="@android:color/holo_green_dark"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@android:color/darker_gray"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"/>

        <!-- Lista de herramientas -->
        <TextView
            android:id="@+id/tvHerramientas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Herramientas: ID1, ID2, ID3"
            android:textSize="14sp"
            android:textColor="@android:color/black"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end" />

        <!-- Fecha y ícono -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">


            <TextView
                android:id="@+id/tvFechaPrestamo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fecha de Préstamo: 01/01/2023"
                android:textSize="14sp"
                android:textColor="@android:color/white" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>